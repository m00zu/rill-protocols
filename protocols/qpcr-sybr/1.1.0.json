  "boxes": [
    {
      "id": "b-samples",
      "label": {
        "en": "Samples",
        "zh-TW": "樣品數"
      },
      "role": "filled",
      "dimension": "count",
      "default": {
        "n": "8",
        "unit": "count"
      }
    },
    {
      "id": "b-ntc",
      "label": {
        "en": "No-template controls",
        "zh-TW": "無模板對照數"
      },
      "role": "fixed",
      "dimension": "count",
      "value": {
        "n": "1",
        "unit": "count"
      }
    },
    {
      "id": "b-reps",
      "label": {
        "en": "Replicates",
        "zh-TW": "重複數"
      },
      "role": "filled",
      "dimension": "number",
      "default": {
        "n": "3",
        "unit": "number"
      }
    },
    {
      "id": "b-wells",
      "label": {
        "en": "Wells per primer pair",
        "zh-TW": "每組引子的孔數"
      },
      "role": "computed",
      "dimension": "count",
      "formula": {
        "op": "*",
        "a": {
          "op": "+",
          "a": {
            "box": "b-samples"
          },
          "b": {
            "box": "b-ntc"
          }
        },
        "b": {
          "box": "b-reps"
        }
      }
    },
    {
      "id": "b-over",
