      "label": {
        "en": "2X SYBR Green master mix · Per well",
        "zh-TW": "2X SYBR Green master mix · 每孔"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "op": "/",
        "a": {
          "box": "b-total"
        },
        "b": {
          "const": {
            "n": "2",
            "unit": "number"
          }
