  "sections": [
    {
      "id": "s-prep",
      "title": {
        "en": "Prepare the reagents",
        "zh-TW": "準備試劑"
      },
      "steps": [
        {
          "id": "st-1",
          "text": {
            "en": [
              "Swirl the ",
              {
                "use": "u-mm"
              },
              " to mix it. Thaw ",
              {
                "use": "u-cdna"
              },
              ", ",
              {
                "use": "u-fwd"
              },
              " and ",
              {
                "use": "u-rev"
              },
              " on ice, vortex and spin briefly."
            ],
            "zh-TW": [
              {
                "text": "旋轉混勻 ",
                "draft": "machine"
              },
              {
                "use": "u-mm"
              },
              {
                "text": "。在冰上解凍 ",
                "draft": "machine"
              },
              {
                "use": "u-cdna"
              },
              {
                "text": "、",
                "draft": "machine"
              },
              {
                "use": "u-fwd"
              },
              {
                "text": " 與 ",
                "draft": "machine"
              },
              {
                "use": "u-rev"
              },
              {
                "text": "，震盪後短暫離心。",
                "draft": "machine"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "s-set",
      "title": {
        "en": "Set up the reactions",
        "zh-TW": "配製反應"
      },
      "steps": [
        {
          "id": "st-2",
          "text": {
            "en": [
              "For each primer pair, ",
              {
                "box": "b-samples"
              },
              " samples and ",
              {
                "box": "b-ntc"
              },
              " no-template control in ",
              {
                "box": "b-reps"
              },
              " replicates make ",
              {
                "box": "b-wells"
              },
              " wells. Mix for them plus ",
              {
                "box": "b-over"
              },
              " extra; each ",
              {
                "box": "b-total"
              },
              " reaction has each primer at ",
              {
                "box": "b-pfinal"
              },
              " from a ",
              {
                "box": "b-pstock"
              },
              " stock:"
            ],
            "zh-TW": [
              {
                "text": "每組引子：",
                "draft": "machine"
              },
              {
                "box": "b-samples"
              },
              {
                "text": " 個樣品加 ",
                "draft": "machine"
              },
              {
                "box": "b-ntc"
              },
              {
