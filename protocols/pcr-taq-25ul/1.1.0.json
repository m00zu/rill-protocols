  "sections": [
    {
      "id": "s-mix",
      "title": {
        "en": "Set up the reactions on ice",
        "zh-TW": "在冰上配製反應"
      },
      "steps": [
        {
          "id": "st-1",
          "text": {
            "en": [
              "Thaw ",
              {
                "use": "u-buffer"
              },
              ", ",
              {
                "use": "u-dntp"
              },
              ", ",
              {
                "use": "u-fwd"
              },
              " and ",
              {
                "use": "u-rev"
              },
              " on ice; mix and spin briefly. Keep ",
              {
                "use": "u-taq"
              },
              " in the cold until it is needed."
            ],
            "zh-TW": [
              {
                "text": "在冰上解凍 ",
                "draft": "machine"
              },
              {
                "use": "u-buffer"
              },
              {
                "text": "、",
                "draft": "machine"
              },
              {
                "use": "u-dntp"
              },
              {
                "text": "、",
                "draft": "machine"
              },
              {
                "use": "u-fwd"
              },
              {
                "text": " 與 ",
                "draft": "machine"
              },
              {
                "use": "u-rev"
              },
              {
                "text": "，混勻並短暫離心。",
                "draft": "machine"
              },
              {
                "use": "u-taq"
              },
              {
