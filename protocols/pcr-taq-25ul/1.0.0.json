  "sections": [
    {
      "id": "s-mix",
      "title": {
        "en": "Set up the reactions on ice",
        "zh-TW": "在冰上配製反應"
      },
      "steps": [
        {
          "id": "st-1",
          "text": {
            "en": [
              "Thaw ",
              {
                "use": "u-buffer"
              },
              ", ",
              {
                "use": "u-dntp"
              },
              ", ",
              {
                "use": "u-fwd"
              },
              " and ",
              {
                "use": "u-rev"
              },
              " on ice; mix and spin briefly. Keep ",
              {
                "use": "u-taq"
              },
              " in the cold until it is needed."
            ],
            "zh-TW": [
              {
                "text": "在冰上解凍 ",
                "draft": "machine"
              },
              {
                "use": "u-buffer"
              },
              {
                "text": "、",
                "draft": "machine"
              },
              {
                "use": "u-dntp"
              },
              {
                "text": "、",
                "draft": "machine"
              },
              {
                "use": "u-fwd"
              },
              {
                "text": " 與 ",
                "draft": "machine"
              },
              {
                "use": "u-rev"
              },
              {
                "text": "，混勻並短暫離心。",
                "draft": "machine"
              },
              {
                "use": "u-taq"
              },
              {
                "text": " 使用前都保持低溫。",
                "draft": "machine"
              }
            ]
          }
        },
        {
          "id": "st-2",
          "text": {
            "en": [
              "For ",
              {
                "box": "b-n"
              },
              " reactions of ",
              {
                "box": "b-total"
              },
              " plus ",
              {
                "box": "b-over"
              },
              " extra, make a master mix of ",
              {
                "box": "b-mm-water"
              },
              " ",
              {
                "use": "u-water"
              },
              ", ",
              {
                "box": "b-mm-buf"
              },
              " buffer, ",
              {
                "box": "b-mm-dntp"
              },
              " dNTPs and ",
              {
                "box": "b-mm-primer"
              },
              " of each primer."
            ],
            "zh-TW": [
              {
                "text": "配製 ",
                "draft": "machine"
              },
              {
                "box": "b-n"
              },
              {
                "text": " 個 ",
                "draft": "machine"
              },
              {
                "box": "b-total"
              },
              {
                "text": " 反應（另加 ",
                "draft": "machine"
              },
              {
                "box": "b-over"
              },
              {
                "text": " 額外量）的混合液：",
                "draft": "machine"
              },
              {
                "box": "b-mm-water"
              },
              {
                "text": " 的 ",
                "draft": "machine"
              },
              {
                "use": "u-water"
              },
              {
                "text": "、",
                "draft": "machine"
              },
              {
                "box": "b-mm-buf"
              },
              {
                "text": " 緩衝液、",
                "draft": "machine"
              },
              {
                "box": "b-mm-dntp"
              },
              {
                "text": " dNTPs，以及每條引子各 ",
                "draft": "machine"
              },
              {
                "box": "b-mm-primer"
              },
              {
                "text": "。",
                "draft": "machine"
              }
            ]
          }
        },
        {
          "id": "st-3",
          "text": {
            "en": [
              "Add ",
              {
                "box": "b-mm-taq"
              },
              " of Taq last and mix gently by pipetting."
            ],
            "zh-TW": [
              {
                "text": "最後加入 ",
                "draft": "machine"
              },
              {
                "box": "b-mm-taq"
              },
              {
                "text": " 的 Taq，以吸管輕輕混勻。",
                "draft": "machine"
              }
            ]
          },
          "caution": {
            "en": "Add the polymerase last and keep everything on ice until the block is hot.",
            "zh-TW": "聚合酶最後加入，並在加熱模組達溫前全程置於冰上。"
          }
        },
        {
          "id": "st-4",
          "text": {
            "en": [
              "Put ",
              {
                "box": "b-per-tube"
              },
              " of master mix into each of the ",
              {
                "use": "u-tubes"
              },
              ", then add ",
              {
                "box": "b-tvol"
              },
              " of ",
              {
                "use": "u-template"
              },
              " (",
              {
                "box": "b-tmass"
              },
              " at ",
              {
                "box": "b-tconc"
              },
              "). Per reaction: buffer ",
              {
                "box": "b-buf"
              },
              ", dNTPs ",
              {
                "box": "b-dntp"
              },
              ", each primer ",
              {
                "box": "b-pvol"
              },
              " (final ",
              {
                "box": "b-pfinal"
              },
              " from ",
              {
                "box": "b-pstock"
              },
              "), Taq ",
              {
                "box": "b-taq"
              },
              ", water ",
              {
                "box": "b-water"
              },
              "."
            ],
            "zh-TW": [
              {
                "text": "每支 ",
                "draft": "machine"
              },
              {
                "use": "u-tubes"
              },
              {
                "text": " 分裝 ",
                "draft": "machine"
              },
              {
                "box": "b-per-tube"
              },
              {
                "text": " 混合液，再加入 ",
                "draft": "machine"
              },
              {
                "box": "b-tvol"
              },
              {
                "text": " 的 ",
                "draft": "machine"
              },
              {
                "use": "u-template"
              },
              {
                "text": "（",
                "draft": "machine"
              },
              {
                "box": "b-tconc"
              },
              {
                "text": " 下為 ",
                "draft": "machine"
              },
              {
                "box": "b-tmass"
              },
              {
                "text": "）。每反應：緩衝液 ",
                "draft": "machine"
              },
              {
                "box": "b-buf"
              },
              {
                "text": "、dNTPs ",
                "draft": "machine"
              },
              {
                "box": "b-dntp"
              },
              {
