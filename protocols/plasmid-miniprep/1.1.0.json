                "box": "b-recovered"
              },
              "; yield ",
              {
                "box": "b-yield"
              },
              "."
            ],
            "zh-TW": [
              {
                "text": "以 ",
                "draft": "machine"
              },
              {
                "use": "i-nanodrop"
              },
              {
                "text": " 測量：",
                "draft": "machine"
              },
              {
                "box": "b-conc"
              },
              {
                "text": "。回收體積 ",
                "draft": "machine"
              },
              {
                "box": "b-recovered"
              },
              {
                "text": "；產量 ",
                "draft": "machine"
              },
              {
                "box": "b-yield"
              },
              {
                "text": "。",
                "draft": "machine"
              }
            ]
          }
        },
