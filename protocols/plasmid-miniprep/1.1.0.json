          },
          "duration": {
            "n": "3",
            "unit": "min"
          }
        },
        {
          "id": "st-19",
          "text": {
            "en": [
              "Measure on the ",
              {
                "use": "i-nanodrop"
              },
              ": ",
              {
                "box": "b-conc"
