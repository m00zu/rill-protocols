    {
      "id": "s-elute",
      "title": {
        "en": "Elute and measure",
        "zh-TW": "溶離與測量"
      },
      "steps": [
        {
          "id": "st-17",
          "text": {
            "en": [
              "Add ",
              {
                "box": "b-elute"
              },
              " of the warmed elution buffer to the centre of the membrane, incubate 5 minutes at 37 °C and spin for ",
              {
                "box": "b-spin"
              },
              "."
