      "id": "b-wr",
      "label": {
        "en": "Working reagent",
        "zh-TW": "工作試劑總量"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "calc": "master_mix",
        "args": {
          "per_reaction": {
            "box": "b-wr-well"
          },
          "n": {
            "box": "b-wells"
          },
          "overage": {
            "box": "b-over"
          }
        }
      },
      "display_unit": "mL"
    },
    {
      "id": "b-ab",
      "label": {
        "en": "Parts of Reagent A per part of Reagent B",
        "zh-TW": "試劑 A 對試劑 B 的份數比"
      },
      "role": "fixed",
      "dimension": "number",
      "value": {
        "n": "50",
        "unit": "number"
      }
    },
    {
      "id": "b-rb",
      "label": {
        "en": "Reagent B",
        "zh-TW": "試劑 B 體積"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "op": "/",
        "a": {
          "box": "b-wr"
        },
        "b": {
          "op": "+",
          "a": {
            "box": "b-ab"
          },
          "b": {
            "const": {
              "n": "1",
              "unit": "number"
            }
          }
        }
      },
      "display_unit": "µL"
    },
    {
      "id": "b-ra",
      "label": {
        "en": "Reagent A",
        "zh-TW": "試劑 A 體積"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "op": "-",
        "a": {
          "box": "b-wr"
        },
        "b": {
          "op": "/",
          "a": {
            "box": "b-wr"
          },
          "b": {
            "op": "+",
            "a": {
              "box": "b-ab"
            },
            "b": {
              "const": {
                "n": "1",
                "unit": "number"
              }
            }
          }
        }
      },
      "display_unit": "mL"
    },
