      "title": {
        "en": "Prepare",
        "zh-TW": "準備"
      },
      "steps": [
        {
          "id": "st-1",
          "text": {
            "en": [
              "Make nine standards from ",
              {
                "use": "u-bsa"
              },
              " and ",
              {
                "use": "u-diluent"
              },
              " in 2 mL tubes:"
            ],
            "zh-TW": [
              {
                "text": "以 ",
                "draft": "machine"
              },
              {
                "use": "u-bsa"
              },
              {
                "text": " 與 ",
                "draft": "machine"
              },
              {
                "use": "u-diluent"
              },
              {
                "text": " 在 2 mL 管中配製九個標準品：",
                "draft": "machine"
              }
            ]
          },
          "table": {
            "name": {
              "en": "Vial",
              "zh-TW": "管"
            },
            "columns": [
              {
                "id": "from",
                "label": {
                  "en": "From",
                  "zh-TW": "取自"
                },
                "kind": "text"
              },
              {
                "id": "vol",
                "label": {
                  "en": "Volume",
                  "zh-TW": "體積"
                },
                "kind": "value",
                "role": "fixed",
                "dimension": "volume",
                "unit": "µL"
              },
              {
                "id": "dil",
                "label": {
                  "en": "Diluent",
                  "zh-TW": "稀釋液"
                },
                "kind": "value",
                "role": "fixed",
                "dimension": "volume",
                "unit": "µL"
              },
              {
                "id": "conc",
                "label": {
                  "en": "BSA",
                  "zh-TW": "BSA 濃度"
                },
                "kind": "value",
                "role": "fixed",
                "dimension": "mass_concentration",
                "unit": "µg/mL"
              }
            ],
            "rows": [
              {
                "id": "a",
                "label": {
                  "en": "A",
                  "zh-TW": "A"
                },
