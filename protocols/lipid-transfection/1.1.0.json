        "storage": "text",
        "lot": "text"
      }
    },
    {
      "use": "u-p3000",
      "role": "P3000 reagent",
      "kind": "rill:reagent",
      "fields": {
        "supplier": "text",
        "catalogue_no": "text",
        "pack_size": "number",
        "concentration": "text",
        "storage": "text",
        "lot": "text"
      }
    },
    {
      "use": "u-plate",
      "role": "24-well plate",
      "kind": "rill:consumable",
      "fields": {
        "supplier": "text",
        "catalogue_no": "text",
        "pack_size": "count",
        "format": "text"
      }
    }
  ],
  "instruments": [
    {
      "use": "i-microscope",
      "role": "inverted microscope",
      "kind": "rill:instrument-microscope",
      "fields": {
        "model": "text",
        "manufacturer": "text",
        "serial_no": "text",
        "location": "text",
        "last_calibration": "text",
        "settings": "text"
      }
    }
  ],
  "boxes": [
    {
      "id": "b-seed",
      "label": {
        "en": "Cells per well (day 0)",
        "zh-TW": "每孔接種細胞數（第 0 天）"
      },
      "role": "filled",
      "dimension": "count",
      "default": {
        "n": "100000",
        "unit": "count"
      }
    },
    {
      "id": "b-wells",
      "label": {
        "en": "Wells to transfect",
        "zh-TW": "欲轉染孔數"
      },
      "role": "filled",
      "dimension": "count",
      "default": {
        "n": "6",
        "unit": "count"
      }
    },
    {
      "id": "b-over",
      "label": {
        "en": "Overage",
        "zh-TW": "額外量比例"
      },
      "role": "fixed",
      "dimension": "ratio",
      "value": {
        "n": "0.1",
        "unit": "ratio"
      }
    },
    {
      "id": "b-opti",
      "label": {
        "en": "Opti-MEM reduced-serum medium · Per well",
        "zh-TW": "Opti-MEM reduced-serum medium · 每孔"
      },
      "role": "fixed",
      "dimension": "volume",
      "value": {
        "n": "25",
        "unit": "µL"
      },
      "preferred_unit": "µL"
    },
    {
      "id": "b-lipo",
      "label": {
        "en": "Lipofectamine 3000 per well",
        "zh-TW": "每孔 Lipofectamine 3000"
      },
      "role": "filled",
      "dimension": "volume",
      "default": {
        "n": "1.5",
        "unit": "µL"
      },
      "preferred_unit": "µL",
      "range": {
        "min": {
          "n": "0.75",
          "unit": "µL"
        },
        "max": {
          "n": "1.5",
          "unit": "µL"
        }
      }
    },
    {
      "id": "b-dna-mass",
      "label": {
        "en": "Plasmid DNA per well",
        "zh-TW": "每孔質體 DNA 量"
      },
      "role": "filled",
      "dimension": "mass",
      "default": {
        "n": "0.5",
        "unit": "µg"
      },
      "preferred_unit": "µg"
    },
    {
      "id": "b-dna-conc",
      "label": {
        "en": "Plasmid concentration",
        "zh-TW": "質體濃度"
      },
      "role": "filled",
      "dimension": "mass_concentration",
      "preferred_unit": "µg/µL",
      "range": {
        "min": {
          "n": "0.5",
          "unit": "µg/µL"
        },
        "max": {
          "n": "5",
          "unit": "µg/µL"
        }
      }
    },
    {
      "id": "b-dna-vol",
      "label": {
        "en": "plasmid DNA · Per well",
        "zh-TW": "plasmid DNA · 每孔"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "calc": "volume_from_mass",
        "args": {
          "mass": {
            "box": "b-dna-mass"
          },
          "concentration": {
            "box": "b-dna-conc"
          }
        }
      },
      "display_unit": "µL"
    },
    {
      "id": "b-lipo-per",
      "label": {
        "en": "Lipofectamine 3000 reagent · Per well",
        "zh-TW": "Lipofectamine 3000 reagent · 每孔"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "box": "b-lipo"
      },
      "display_unit": "µL"
    },
    {
      "id": "b-opti-2",
      "label": {
        "en": "Opti-MEM reduced-serum medium · Per well",
        "zh-TW": "Opti-MEM reduced-serum medium · 每孔"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "box": "b-opti"
      },
      "display_unit": "µL"
    },
    {
      "id": "b-p3000",
      "label": {
        "en": "P3000 reagent · Per well",
        "zh-TW": "P3000 reagent · 每孔"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "op": "*",
        "a": {
          "box": "b-dna-mass"
        },
        "b": {
          "op": "/",
          "a": {
            "const": {
              "n": "2",
              "unit": "µL"
            }
          },
          "b": {
            "const": {
              "n": "1",
              "unit": "µg"
            }
          }
        }
      },
      "display_unit": "µL"
    },
    {
      "id": "b-t1-opti",
      "label": {
        "en": "Opti-MEM reduced-serum medium · Mix",
        "zh-TW": "Opti-MEM reduced-serum medium · 混合液"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "calc": "master_mix",
        "args": {
          "per_reaction": {
            "box": "b-opti"
          },
          "n": {
            "box": "b-wells"
          },
          "overage": {
            "box": "b-over"
          }
        }
      },
      "display_unit": "µL"
    },
    {
      "id": "b-t1-lipo",
      "label": {
        "en": "Lipofectamine 3000 reagent · Mix",
        "zh-TW": "Lipofectamine 3000 reagent · 混合液"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "calc": "master_mix",
        "args": {
          "per_reaction": {
            "box": "b-lipo-per"
          },
          "n": {
            "box": "b-wells"
          },
          "overage": {
            "box": "b-over"
          }
        }
      },
      "display_unit": "µL"
    },
    {
      "id": "b-t2-opti",
      "label": {
        "en": "Opti-MEM reduced-serum medium · Mix",
        "zh-TW": "Opti-MEM reduced-serum medium · 混合液"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "calc": "master_mix",
        "args": {
          "per_reaction": {
            "box": "b-opti-2"
          },
          "n": {
            "box": "b-wells"
          },
          "overage": {
            "box": "b-over"
          }
        }
      },
      "display_unit": "µL"
    },
    {
      "id": "b-t2-dna",
      "label": {
        "en": "plasmid DNA · Mix",
        "zh-TW": "plasmid DNA · 混合液"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "calc": "master_mix",
        "args": {
          "per_reaction": {
            "box": "b-dna-vol"
          },
          "n": {
            "box": "b-wells"
          },
          "overage": {
            "box": "b-over"
          }
        }
      },
      "display_unit": "µL"
    },
    {
      "id": "b-t2-p3000",
      "label": {
        "en": "P3000 reagent · Mix",
        "zh-TW": "P3000 reagent · 混合液"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "calc": "master_mix",
        "args": {
          "per_reaction": {
            "box": "b-p3000"
          },
          "n": {
            "box": "b-wells"
          },
          "overage": {
            "box": "b-over"
          }
        }
      },
      "display_unit": "µL"
    },
    {
      "id": "b-complex-time",
      "label": {
        "en": "Complexing time",
        "zh-TW": "複合物形成時間"
      },
      "role": "filled",
      "dimension": "time",
      "default": {
        "n": "15",
        "unit": "min"
      },
      "preferred_unit": "min",
      "range": {
        "min": {
          "n": "10",
          "unit": "min"
        },
        "max": {
          "n": "15",
          "unit": "min"
        }
      }
    },
    {
      "id": "b-per-well",
      "label": {
        "en": "Complex per well",
        "zh-TW": "每孔加入的複合物"
      },
      "role": "fixed",
      "dimension": "volume",
      "value": {
        "n": "50",
        "unit": "µL"
      }
    },
    {
      "id": "b-plate",
      "label": {
        "en": "Transfected wells",
        "zh-TW": "轉染孔位"
      },
      "role": "filled",
      "type": "layout",
      "format": {
        "kind": "grid",
        "rows": 4,
        "columns": 6,
        "labels": "letters-numbers"
      },
      "template": []
    },
    {
      "id": "b-expression",
      "label": {
        "en": "Time to analysis",
        "zh-TW": "至分析的時間"
      },
      "role": "filled",
      "dimension": "time",
      "default": {
        "n": "48",
        "unit": "h"
      },
      "preferred_unit": "h",
      "range": {
        "min": {
          "n": "24",
          "unit": "h"
        },
        "max": {
          "n": "72",
          "unit": "h"
        }
      }
    }
  ],
  "sections": [
    {
      "id": "s-day0",
      "title": {
        "en": "Day 0 — Plate the cells",
        "zh-TW": "第 0 天 — 接種細胞"
      },
      "steps": [
        {
          "id": "st-1",
          "text": {
            "en": [
              "Plate ",
              {
                "box": "b-seed"
              },
              " of ",
              {
                "use": "u-cells"
              },
              " per well in a ",
              {
                "use": "u-plate"
              },
              "."
            ],
            "zh-TW": [
              {
                "text": "在 ",
                "draft": "machine"
              },
              {
                "use": "u-plate"
              },
              {
                "text": " 中每孔接種 ",
                "draft": "machine"
              },
              {
                "box": "b-seed"
              },
              {
                "text": " 的 ",
                "draft": "machine"
              },
              {
                "use": "u-cells"
              },
              {
                "text": "。",
                "draft": "machine"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "s-day1",
      "title": {
        "en": "Day 1 — Transfect",
        "zh-TW": "第 1 天 — 轉染"
      },
      "steps": [
        {
          "id": "st-2",
          "text": {
            "en": [
              "Check the cells on the ",
              {
                "use": "i-microscope"
              },
              ": transfect at about 60–70% confluence; if they are below that, wait another day."
            ],
            "zh-TW": [
              {
                "text": "以 ",
                "draft": "machine"
              },
              {
                "use": "i-microscope"
              },
              {
                "text": " 檢查細胞：細胞覆蓋率約 60–70% 時進行轉染；若未達到，再等一天。",
                "draft": "machine"
              }
            ]
          }
        },
        {
          "id": "st-3",
          "text": {
            "en": [
              "Measure the ",
              {
                "use": "u-plasmid"
              },
              " concentration (",
              {
                "box": "b-dna-conc"
              },
              ") and dilute if needed; use ",
              {
                "box": "b-dna-mass"
              },
              " per well."
            ],
            "zh-TW": [
              {
                "text": "測量 ",
                "draft": "machine"
              },
              {
                "use": "u-plasmid"
              },
              {
                "text": " 濃度（",
                "draft": "machine"
              },
              {
                "box": "b-dna-conc"
              },
              {
                "text": "），必要時稀釋；每孔使用 ",
                "draft": "machine"
              },
              {
                "box": "b-dna-mass"
              },
              {
                "text": "。",
                "draft": "machine"
              }
            ]
          }
        },
        {
          "id": "st-4",
          "text": {
            "en": [
              "For ",
              {
                "box": "b-wells"
              },
              " wells plus ",
              {
                "box": "b-over"
              },
              " extra, with ",
              {
                "box": "b-lipo"
              },
              " of Lipofectamine per well, make tube 1 per plasmid:"
            ],
            "zh-TW": [
              {
                "text": "依 ",
                "draft": "machine"
              },
              {
                "box": "b-wells"
              },
              {
                "text": " 孔（另加 ",
                "draft": "machine"
              },
              {
                "box": "b-over"
              },
              {
                "text": " 額外量）、每孔 Lipofectamine ",
                "draft": "machine"
              },
              {
                "box": "b-lipo"
              },
              {
                "text": "，每種質體配製管 1：",
                "draft": "machine"
              }
            ]
          },
          "table": {
            "name": {
              "en": "Tube 1",
              "zh-TW": "管 1"
            },
            "columns": [
              {
                "id": "per",
                "label": {
                  "en": "Per well",
                  "zh-TW": "每孔"
                },
                "kind": "value",
                "role": "fixed",
                "dimension": "volume",
                "unit": "µL"
              },
              {
                "id": "mix",
                "label": {
                  "en": "Mix",
                  "zh-TW": "混合液"
                },
                "kind": "value",
                "role": "computed",
                "dimension": "volume",
                "unit": "µL",
                "formula": {
                  "calc": "master_mix",
                  "args": {
                    "per_reaction": {
                      "cell": "per"
                    },
                    "n": {
                      "box": "b-wells"
                    },
                    "overage": {
                      "box": "b-over"
                    }
                  }
                }
              }
            ],
            "rows": [
              {
                "id": "opti",
                "use": "u-optimem",
                "cells": {
                  "per": "b-opti",
                  "mix": "b-t1-opti"
                }
              },
              {
                "id": "lipo",
                "use": "u-lipo",
                "cells": {
                  "per": "b-lipo-per",
                  "mix": "b-t1-lipo"
                },
                "rule": {
                  "column": "per",
                  "formula": {
                    "box": "b-lipo"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "st-5",
          "text": {
            "en": [
              "Make tube 2 (P3000: 2 µL per µg of DNA):"
            ],
            "zh-TW": [
              {
                "text": "配製管 2（P3000：每 µg DNA 用 2 µL）：",
                "draft": "machine"
              }
            ]
          },
          "table": {
            "name": {
              "en": "Tube 2",
              "zh-TW": "管 2"
            },
            "columns": [
              {
                "id": "per",
                "label": {
                  "en": "Per well",
                  "zh-TW": "每孔"
                },
                "kind": "value",
                "role": "fixed",
                "dimension": "volume",
                "unit": "µL"
              },
              {
                "id": "mix",
                "label": {
                  "en": "Mix",
                  "zh-TW": "混合液"
                },
                "kind": "value",
                "role": "computed",
                "dimension": "volume",
                "unit": "µL",
                "formula": {
                  "calc": "master_mix",
                  "args": {
                    "per_reaction": {
                      "cell": "per"
                    },
                    "n": {
                      "box": "b-wells"
                    },
                    "overage": {
                      "box": "b-over"
                    }
                  }
                }
              }
            ],
            "rows": [
              {
                "id": "opti",
                "use": "u-optimem",
                "cells": {
                  "per": "b-opti-2",
                  "mix": "b-t2-opti"
                },
                "rule": {
                  "column": "per",
                  "formula": {
                    "box": "b-opti"
                  }
                }
              },
              {
                "id": "dna",
                "use": "u-plasmid",
                "cells": {
                  "per": "b-dna-vol",
                  "mix": "b-t2-dna"
                },
                "rule": {
                  "column": "per",
                  "formula": {
                    "calc": "volume_from_mass",
                    "args": {
                      "mass": {
                        "box": "b-dna-mass"
                      },
                      "concentration": {
                        "box": "b-dna-conc"
                      }
                    }
                  }
                }
              },
              {
                "id": "p3000",
                "use": "u-p3000",
                "cells": {
                  "per": "b-p3000",
                  "mix": "b-t2-p3000"
                },
                "rule": {
                  "column": "per",
                  "formula": {
                    "op": "*",
                    "a": {
                      "box": "b-dna-mass"
                    },
                    "b": {
                      "op": "/",
                      "a": {
                        "const": {
                          "n": "2",
                          "unit": "µL"
                        }
                      },
                      "b": {
                        "const": {
                          "n": "1",
                          "unit": "µg"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "id": "st-6",
          "text": {
            "en": [
              "Add tube 2 to tube 1, mix well and incubate at room temperature for ",
              {
                "box": "b-complex-time"
              },
              "."
            ],
            "zh-TW": [
              {
                "text": "將管 2 加入管 1，充分混勻，室溫靜置 ",
                "draft": "machine"
              },
              {
                "box": "b-complex-time"
              },
              {
                "text": "。",
                "draft": "machine"
              }
            ]
          },
          "caution": {
            "en": "Use the complexes soon after they form.",
            "zh-TW": "複合物形成後請盡快使用。"
          },
          "duration": {
            "box": "b-complex-time"
          }
        },
        {
          "id": "st-7",
          "text": {
            "en": [
              "Add ",
              {
                "box": "b-per-well"
              },
              " of complex to each well and swirl the plate gently so it spreads evenly. Record the wells: ",
              {
                "box": "b-plate"
              }
            ],
            "zh-TW": [
              {
                "text": "每孔加入 ",
                "draft": "machine"
              },
              {
                "box": "b-per-well"
              },
              {
                "text": " 複合物，輕輕旋轉培養盤使其均勻分布。記錄孔位：",
                "draft": "machine"
              },
              {
                "box": "b-plate"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "s-after",
      "title": {
        "en": "After transfection",
        "zh-TW": "轉染後"
      },
      "steps": [
        {
          "id": "st-8",
          "text": {
            "en": [
              "Return the plate to the incubator and analyse after ",
              {
                "box": "b-expression"
              },
              "."
            ],
            "zh-TW": [
              {
                "text": "將培養盤放回培養箱，",
                "draft": "machine"
              },
              {
                "box": "b-expression"
              },
              {
                "text": " 後進行分析。",
                "draft": "machine"
              }
            ]
          },
          "duration": {
            "box": "b-expression"
          }
        }
      ]
    }
  ],
