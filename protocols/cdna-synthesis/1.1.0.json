{
  "format": "rill-protocol",
  "version": 1,
  "title": {
    "en": "cDNA synthesis",
    "zh-TW": "cDNA 合成"
  },
  "tags": [
    "cDNA",
    "reverse transcription",
    "RT",
    "RNA"
  ],
  "source": {
    "title": "Reverse Transcription (cDNA generation) using RevertAid RT",
    "authors": [
      "David Valle-Garcia"
    ],
    "doi": "10.17504/protocols.io.g5sdby6a7",
    "licence": "CC BY 4.0"
  },
  "languages": [
    "en",
    "zh-TW"
  ],
  "materials": [
    {
      "use": "u-rna",
      "role": "purified RNA",
      "kind": "rill:other",
      "fields": {
        "notes": "text"
      }
    },
    {
      "use": "u-water",
      "role": "nuclease-free water",
      "kind": "rill:medium-buffer",
      "fields": {
        "composition": "text",
        "ph": "number",
        "final_volume": "volume",
        "supplier": "text",
        "catalogue_no": "text",
        "storage": "text",
        "notes": "text",
        "lot": "text"
      }
    },
    {
      "use": "u-dntp",
      "role": "10 mM dNTPs",
      "kind": "rill:reagent",
      "fields": {
        "supplier": "text",
        "catalogue_no": "text",
        "pack_size": "number",
        "concentration": "text",
        "storage": "text",
        "lot": "text"
      }
    },
    {
      "use": "u-odt",
      "role": "oligo(dT)18 primer, 50 µM",
      "kind": "rill:primer",
      "fields": {
        "sequence": "text",
        "direction": "text",
        "target": "text",
        "tm": "temperature",
        "supplier": "text",
        "pair": "text"
      }
    },
    {
      "use": "u-hex",
      "role": "random hexamers, 50 µM",
      "kind": "rill:primer",
      "fields": {
        "sequence": "text",
        "direction": "text",
        "target": "text",
        "tm": "temperature",
        "supplier": "text",
        "pair": "text"
      }
    },
    {
      "use": "u-buf",
      "role": "5X RT buffer",
      "kind": "rill:reagent",
      "fields": {
        "supplier": "text",
        "catalogue_no": "text",
        "pack_size": "number",
        "concentration": "text",
        "storage": "text",
        "lot": "text"
      }
    },
    {
      "use": "u-rt",
      "role": "reverse transcriptase (RevertAid)",
      "kind": "rill:reagent",
      "fields": {
        "supplier": "text",
        "catalogue_no": "text",
        "pack_size": "number",
        "concentration": "text",
        "storage": "text",
        "lot": "text"
      }
    },
    {
      "use": "u-tubes",
      "role": "PCR tubes",
      "kind": "rill:consumable",
      "fields": {
        "supplier": "text",
        "catalogue_no": "text",
        "pack_size": "count",
        "format": "text"
      }
    }
  ],
  "instruments": [
    {
      "use": "i-cycler",
      "role": "thermocycler",
      "kind": "rill:instrument-other",
      "fields": {
        "model": "text",
        "manufacturer": "text",
        "serial_no": "text",
        "location": "text",
        "last_calibration": "text",
        "settings": "text"
      }
    }
  ],
  "boxes": [
    {
      "id": "b-n",
      "label": {
        "en": "Samples",
        "zh-TW": "樣品數"
      },
      "role": "filled",
      "dimension": "count",
      "default": {
        "n": "4",
        "unit": "count"
      }
    },
    {
      "id": "b-extra",
      "label": {
        "en": "Extra reactions in the mix",
        "zh-TW": "混合液的額外反應數"
      },
      "role": "fixed",
      "dimension": "count",
      "value": {
        "n": "0.5",
        "unit": "count"
      }
    },
    {
      "id": "b-rna-mass",
      "label": {
        "en": "RNA per reaction",
        "zh-TW": "每反應 RNA 量"
      },
      "role": "filled",
      "dimension": "mass",
      "default": {
        "n": "500",
        "unit": "ng"
      },
      "preferred_unit": "ng",
      "range": {
        "min": {
          "n": "100",
          "unit": "ng"
        }
      }
    },
    {
      "id": "b-rna-conc",
      "label": {
        "en": "RNA concentration",
        "zh-TW": "RNA 濃度"
      },
      "role": "filled",
      "dimension": "mass_concentration",
      "preferred_unit": "ng/µL",
      "range": {
        "min": {
          "n": "40",
          "unit": "ng/µL"
        }
      }
    },
    {
      "id": "b-rna-vol",
      "label": {
        "en": "RNA volume",
        "zh-TW": "RNA 體積"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "calc": "volume_from_mass",
        "args": {
          "mass": {
            "box": "b-rna-mass"
          },
          "concentration": {
            "box": "b-rna-conc"
          }
        }
      },
      "display_unit": "µL"
    },
    {
      "id": "b-rna-final",
      "label": {
        "en": "RNA diluted to",
        "zh-TW": "RNA 稀釋後體積"
      },
      "role": "fixed",
      "dimension": "volume",
      "value": {
        "n": "12.8",
        "unit": "µL"
      }
    },
    {
      "id": "b-water",
      "label": {
        "en": "Water",
        "zh-TW": "水"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "op": "-",
        "a": {
          "box": "b-rna-final"
        },
        "b": {
          "box": "b-rna-vol"
        }
      },
      "display_unit": "µL"
    },
    {
      "id": "b-dntp",
      "label": {
        "en": "dNTPs",
        "zh-TW": "dNTPs 體積"
      },
      "role": "fixed",
      "dimension": "volume",
      "value": {
        "n": "1",
        "unit": "µL"
      }
    },
    {
      "id": "b-odt",
      "label": {
        "en": "Oligo(dT)",
        "zh-TW": "Oligo(dT) 體積"
      },
      "role": "fixed",
      "dimension": "volume",
      "value": {
        "n": "1",
        "unit": "µL"
      }
    },
    {
      "id": "b-hex",
      "label": {
        "en": "Random hexamers",
        "zh-TW": "隨機六聚體體積"
      },
      "role": "fixed",
      "dimension": "volume",
      "value": {
        "n": "1",
        "unit": "µL"
      }
    },
    {
      "id": "b-buf",
      "label": {
        "en": "5X RT buffer · Per reaction",
        "zh-TW": "5X RT buffer · 每反應"
      },
      "role": "fixed",
      "dimension": "volume",
      "value": {
        "n": "4",
        "unit": "µL"
      },
      "preferred_unit": "µL"
    },
    {
      "id": "b-rt",
      "label": {
        "en": "reverse transcriptase (RevertAid) · Per reaction",
        "zh-TW": "reverse transcriptase (RevertAid) · 每反應"
      },
      "role": "fixed",
      "dimension": "volume",
      "value": {
        "n": "0.2",
        "unit": "µL"
      },
      "preferred_unit": "µL"
    },
    {
      "id": "b-mix-per",
      "label": {
        "en": "Enzyme mix per reaction",
        "zh-TW": "每反應酵素混合液"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "op": "+",
        "a": {
          "box": "b-buf"
        },
        "b": {
          "box": "b-rt"
        }
      },
      "display_unit": "µL"
    },
    {
      "id": "b-mm-buf",
      "label": {
        "en": "5X RT buffer · Mix",
        "zh-TW": "5X RT buffer · 混合液"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "calc": "master_mix",
        "args": {
          "per_reaction": {
            "box": "b-buf"
          },
          "n": {
            "op": "+",
            "a": {
              "box": "b-n"
            },
            "b": {
              "box": "b-extra"
            }
          },
          "overage": {
            "const": {
              "n": "0",
              "unit": "ratio"
            }
          }
        }
      },
      "display_unit": "µL"
    },
    {
      "id": "b-mm-rt",
      "label": {
        "en": "reverse transcriptase (RevertAid) · Mix",
        "zh-TW": "reverse transcriptase (RevertAid) · 混合液"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "calc": "master_mix",
        "args": {
          "per_reaction": {
            "box": "b-rt"
          },
          "n": {
            "op": "+",
            "a": {
              "box": "b-n"
            },
            "b": {
              "box": "b-extra"
            }
          },
          "overage": {
            "const": {
              "n": "0",
              "unit": "ratio"
            }
          }
        }
      },
      "display_unit": "µL"
    },
    {
      "id": "b-total",
      "label": {
        "en": "Reaction volume",
        "zh-TW": "反應體積"
      },
      "role": "computed",
      "dimension": "volume",
      "formula": {
        "op": "+",
        "a": {
          "op": "+",
          "a": {
            "op": "+",
            "a": {
              "op": "+",
              "a": {
                "op": "+",
                "a": {
                  "box": "b-rna-final"
                },
                "b": {
                  "box": "b-dntp"
                }
              },
              "b": {
                "box": "b-odt"
              }
            },
            "b": {
              "box": "b-hex"
            }
          },
          "b": {
            "box": "b-buf"
          }
        },
        "b": {
          "box": "b-rt"
        }
      },
      "display_unit": "µL"
    },
    {
      "id": "b-rt1-t",
      "label": {
        "en": "Hexamer annealing temperature",
        "zh-TW": "六聚體黏合溫度"
      },
      "role": "fixed",
      "dimension": "temperature",
      "value": {
        "n": "25",
        "unit": "°C"
      },
      "preferred_unit": "°C"
    },
    {
      "id": "b-rt1",
      "label": {
        "en": "Hexamer annealing time",
        "zh-TW": "六聚體黏合時間"
      },
      "role": "fixed",
      "dimension": "time",
      "value": {
        "n": "10",
        "unit": "min"
      },
      "preferred_unit": "min"
    },
    {
      "id": "b-rt2-t",
      "label": {
        "en": "Reverse transcription temperature",
        "zh-TW": "反轉錄溫度"
      },
      "role": "fixed",
      "dimension": "temperature",
      "value": {
        "n": "42",
        "unit": "°C"
      },
      "preferred_unit": "°C"
    },
    {
      "id": "b-rt2",
      "label": {
        "en": "Reverse transcription time",
        "zh-TW": "反轉錄時間"
      },
      "role": "fixed",
      "dimension": "time",
      "value": {
        "n": "60",
        "unit": "min"
      },
      "preferred_unit": "min"
    },
    {
      "id": "b-rt3-t",
      "label": {
        "en": "Inactivation temperature",
        "zh-TW": "失活溫度"
      },
      "role": "fixed",
      "dimension": "temperature",
      "value": {
        "n": "70",
        "unit": "°C"
      },
      "preferred_unit": "°C"
    },
    {
      "id": "b-rt3",
      "label": {
        "en": "Inactivation time",
        "zh-TW": "失活時間"
      },
      "role": "fixed",
      "dimension": "time",
      "value": {
        "n": "15",
        "unit": "min"
      },
      "preferred_unit": "min"
    },
    {
      "id": "b-rt-hold",
      "label": {
        "en": "Hold temperature",
        "zh-TW": "保存溫度"
      },
      "role": "fixed",
      "dimension": "temperature",
      "value": {
        "n": "10",
        "unit": "°C"
      },
      "preferred_unit": "°C"
    },
    {
      "id": "b-rt-run",
      "label": {
        "en": "Hold times",
        "zh-TW": "保溫時間合計"
      },
      "role": "computed",
      "dimension": "time",
      "formula": {
        "op": "+",
        "a": {
          "op": "+",
          "a": {
            "box": "b-rt1"
          },
          "b": {
            "box": "b-rt2"
          }
        },
        "b": {
          "box": "b-rt3"
        }
      },
      "display_unit": "min"
    },
    {
      "id": "b-dil-water",
      "label": {
        "en": "Water for the 1:10 dilution",
        "zh-TW": "1:10 稀釋用水"
      },
      "role": "fixed",
      "dimension": "volume",
      "value": {
        "n": "180",
        "unit": "µL"
      }
    }
  ],
  "sections": [
    {
      "id": "s-prep",
      "title": {
        "en": "Prepare the RNA",
        "zh-TW": "準備 RNA"
      },
      "steps": [
        {
          "id": "st-1",
          "text": {
            "en": [
              "Thaw ",
              {
                "use": "u-rna"
              },
              ", ",
              {
                "use": "u-buf"
              },
              ", ",
              {
                "use": "u-odt"
              },
              " and ",
              {
                "use": "u-hex"
              },
              " on ice; vortex and spin briefly. Leave ",
              {
                "use": "u-rt"
              },
              " in the freezer until it is needed."
            ],
            "zh-TW": [
              {
                "text": "在冰上解凍 ",
                "draft": "machine"
              },
              {
                "use": "u-rna"
              },
              {
                "text": "、",
                "draft": "machine"
              },
              {
                "use": "u-buf"
              },
              {
                "text": "、",
                "draft": "machine"
              },
              {
                "use": "u-odt"
              },
              {
                "text": " 與 ",
                "draft": "machine"
              },
              {
                "use": "u-hex"
              },
              {
                "text": "，震盪後短暫離心。",
                "draft": "machine"
              },
              {
                "use": "u-rt"
              },
              {
                "text": " 需要時才從冷凍庫取出。",
                "draft": "machine"
              }
            ]
          },
          "caution": {
            "en": "Use clean gloves and RNase-free tips and tubes.",
            "zh-TW": "請使用乾淨的手套與無 RNase 的吸管尖和離心管。"
          }
        },
        {
          "id": "st-2",
          "text": {
            "en": [
              "In ",
              {
                "use": "u-tubes"
              },
              ", dilute ",
              {
                "box": "b-rna-vol"
              },
              " of RNA (",
              {
                "box": "b-rna-mass"
              },
              " at ",
              {
                "box": "b-rna-conc"
              },
              ") with ",
              {
                "box": "b-water"
              },
              " of ",
              {
                "use": "u-water"
              },
              " to ",
              {
                "box": "b-rna-final"
              },
              "."
            ],
            "zh-TW": [
              {
                "text": "在 ",
                "draft": "machine"
              },
              {
                "use": "u-tubes"
              },
              {
                "text": " 中，將 ",
                "draft": "machine"
              },
              {
                "box": "b-rna-vol"
              },
              {
                "text": " 的 RNA（",
                "draft": "machine"
              },
              {
                "box": "b-rna-conc"
              },
              {
                "text": " 下為 ",
                "draft": "machine"
              },
              {
                "box": "b-rna-mass"
              },
              {
                "text": "）以 ",
                "draft": "machine"
              },
              {
                "box": "b-water"
              },
              {
                "text": " 的 ",
                "draft": "machine"
              },
              {
                "use": "u-water"
              },
              {
                "text": " 稀釋至 ",
                "draft": "machine"
              },
              {
                "box": "b-rna-final"
              },
              {
                "text": "。",
                "draft": "machine"
              }
            ]
          },
          "caution": {
            "en": "Below about 40 ng/µL, 500 ng of RNA does not fit in 12.8 µL and the water volume turns negative: use less RNA or concentrate it.",
            "zh-TW": "濃度低於約 40 ng/µL 時，500 ng RNA 放不進 12.8 µL，水量會變成負值：請減少 RNA 用量或先濃縮。"
          }
        },
        {
          "id": "st-3",
          "text": {
            "en": [
              "Add ",
              {
                "box": "b-dntp"
              },
              " of ",
              {
                "use": "u-dntp"
              },
              ", ",
              {
                "box": "b-odt"
              },
              " of oligo(dT) and ",
              {
                "box": "b-hex"
              },
              " of random hexamers."
            ],
            "zh-TW": [
              {
                "text": "加入 ",
                "draft": "machine"
              },
              {
                "box": "b-dntp"
              },
              {
                "text": " 的 ",
                "draft": "machine"
              },
              {
                "use": "u-dntp"
              },
              {
                "text": "、",
                "draft": "machine"
              },
              {
                "box": "b-odt"
              },
              {
                "text": " 的 oligo(dT) 與 ",
                "draft": "machine"
              },
              {
                "box": "b-hex"
              },
              {
                "text": " 的隨機六聚體。",
                "draft": "machine"
              }
            ]
          },
          "caution": {
            "en": "Use random hexamers only if the qPCR primers span exon–exon junctions or genomic DNA is not a concern.",
            "zh-TW": "只有在 qPCR 引子跨越外顯子交界、或不擔心基因體 DNA 污染時，才使用隨機六聚體。"
          }
        },
        {
          "id": "st-4",
          "text": {
            "en": [
              "Heat at 65 °C for 5 minutes in the ",
              {
                "use": "i-cycler"
              },
              ", then chill on ice for about 2 minutes."
            ],
            "zh-TW": [
              {
                "text": "以 ",
                "draft": "machine"
              },
              {
                "use": "i-cycler"
              },
              {
                "text": " 在 65 °C 加熱 5 分鐘，之後立即置於冰上約 2 分鐘。",
                "draft": "machine"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "s-rt",
      "title": {
        "en": "Reverse transcription",
        "zh-TW": "反轉錄"
      },
      "steps": [
        {
          "id": "st-5",
          "text": {
            "en": [
              "For ",
              {
                "box": "b-n"
              },
              " samples plus ",
              {
                "box": "b-extra"
              },
              " extra, mix the enzyme mix:"
            ],
            "zh-TW": [
              {
                "box": "b-n"
              },
              {
                "text": " 個樣品另加 ",
                "draft": "machine"
              },
              {
                "box": "b-extra"
              },
              {
                "text": " 份，配製酵素混合液：",
                "draft": "machine"
              }
            ]
          },
          "table": {
            "name": {
              "en": "Component",
              "zh-TW": "成分"
            },
            "columns": [
              {
                "id": "per",
                "label": {
                  "en": "Per reaction",
                  "zh-TW": "每反應"
                },
                "kind": "value",
                "role": "fixed",
                "dimension": "volume",
                "unit": "µL"
              },
              {
                "id": "mix",
                "label": {
                  "en": "Mix",
                  "zh-TW": "混合液"
                },
                "kind": "value",
                "role": "computed",
                "dimension": "volume",
                "unit": "µL",
                "formula": {
                  "calc": "master_mix",
                  "args": {
                    "per_reaction": {
                      "cell": "per"
                    },
                    "n": {
                      "op": "+",
                      "a": {
                        "box": "b-n"
                      },
                      "b": {
                        "box": "b-extra"
                      }
                    },
                    "overage": {
                      "const": {
                        "n": "0",
                        "unit": "ratio"
                      }
                    }
                  }
                }
              }
            ],
            "rows": [
              {
                "id": "buf",
                "use": "u-buf",
                "cells": {
                  "per": "b-buf",
                  "mix": "b-mm-buf"
                }
              },
              {
                "id": "rt",
                "use": "u-rt",
                "cells": {
                  "per": "b-rt",
                  "mix": "b-mm-rt"
                }
              }
            ]
          }
        },
        {
          "id": "st-6",
          "text": {
            "en": [
              "Add ",
              {
                "box": "b-mix-per"
              },
              " of enzyme mix to each chilled sample, for ",
              {
                "box": "b-total"
              },
              " in all."
            ],
            "zh-TW": [
              {
                "text": "每個冷卻的樣品加入 ",
                "draft": "machine"
              },
              {
                "box": "b-mix-per"
              },
              {
                "text": " 酵素混合液，總體積 ",
                "draft": "machine"
              },
              {
                "box": "b-total"
              },
              {
                "text": "。",
                "draft": "machine"
              }
            ]
          }
        },
        {
          "id": "st-7",
