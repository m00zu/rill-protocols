{
  "format": "rill-protocol",
  "version": 1,
  "title": {
    "en": "Agarose gel electrophoresis",
    "zh-TW": "瓊脂糖凝膠電泳"
  },
  "tags": [
    "agarose gel",
    "electrophoresis",
    "DNA",
    "TAE"
  ],
  "source": {
    "title": "Agarose Gel Electrophoresis: DNA",
    "authors": [
      "Raven Coffer"
    ],
    "doi": "10.17504/protocols.io.bp2l6odjrlqe/v1",
    "licence": "CC BY 4.0"
  },
  "languages": [
    "en",
    "zh-TW"
  ],
  "materials": [
    {
      "use": "u-agarose",
      "role": "agarose",
      "kind": "rill:reagent",
      "fields": {
        "supplier": "text",
